<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <include layout="@layout/notification_collapsed" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/n_cell_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/n_name_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="الفجر"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/n_time_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="4:35"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/n_cell_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/n_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="الشروق"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/n_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="5:55"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/n_cell_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/n_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="الظهر"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/n_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="12:05"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/n_cell_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/n_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="العصر"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/n_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="3:20"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/n_cell_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/n_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="المغرب"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/n_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="6:10"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/n_cell_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/n_name_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="العشاء"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/n_time_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="7:40"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/n_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="27 ربيع الآخر 1448 هـ"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
</LinearLayout>
